def pull_version(store, root, name, version, entry):
    files = entry["files"]
    need = sum(f["size"] for f in files)
    free = shutil.disk_usage(root).free
    if free < need * 1.2 + (512 << 20):
        raise DAError(f"not enough disk space in {root}: need about {human(need * 1.2)}, free {human(free)}")
    prefix = model_prefix(name, version)
    tmp = Path(tempfile.mkdtemp(prefix=f"{name}-{version}-", dir=root / ".tmp"))
    try:
        # publish writes model.json last, so it proves that the upload is complete.
        remote = tmp / ".remote-model.json"
        store.download(prefix + "model.json", remote)
        check_same_files(entry, read_json(remote)["entry"], f"{store.url(prefix + 'model.json')}")
        remote.unlink()
        for f in files:
            info(f"  get   {f['name']} ({human(f['size'])})")
            dst = tmp / f["name"]
            store.download(prefix + f["name"], dst)
            check_file(dst, f)
            info(f"  ok    sha256 {f['sha256'][:16]}...")
        rt = entry.get("runtime")
        if rt:
            extract_tar(tmp / rt["file"], tmp)
        write_json(tmp / "model.json", {"name": name, "version": version, "bucket": store.url(""),
                                        "pulled_at": now_utc(), "entry": entry})
        (root / name).mkdir(exist_ok=True)
        os.rename(tmp, root / name / version)  # atomic on the same file system
    except BaseException:
        shutil.rmtree(tmp, ignore_errors=True)
        raise


def cmd_pull(args):
    man = load_manifest(args)
    name, ver = split_ref(args.ref)
    version, entry = man.select(name, ver)
    status = entry.get("status")
    root = store_root(args)
    with locked_root(root):
        dest = root / name / version
        if dest.is_dir():
            problems = check_version_dir(dest, quick=True)
            if problems:
                raise DAError(f"{dest} exists but is not complete ({problems[0]}). "
                              f"Move it away, then pull again.")
            check_same_files(entry, read_json(dest / "model.json")["entry"], str(dest))
            info(f"{name}@{version} ({status}) is already in {dest}")
        else:
            store = open_store(man, args.credentials)
            info(f"pull {name}@{version} ({status}) from {store.url(model_prefix(name, version))}")
            pull_version(store, root, name, version, entry)
            info(f"{name}@{version} is in {dest}")
        if args.set_current or (status == "production" and not args.no_current):
            set_current(root, name, version)
            info(f"{root / name / 'current'} -> {version}")
        else:
            info(f"`current` not changed: {name}@{version} is {status}. Use --set-current to select it.")


