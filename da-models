def deterministic_targz(out, members):
    """Write (arcname, path) pairs to a .tar.gz with fixed metadata."""
    with open(out, "wb") as fo, gzip.GzipFile(filename="", mode="wb", fileobj=fo, mtime=0) as gz, \
            tarfile.open(fileobj=gz, mode="w", format=tarfile.PAX_FORMAT) as t:
        for arcname, path in sorted(members):
            ti = tarfile.TarInfo(arcname)
            ti.size = Path(path).stat().st_size
            ti.mode = 0o755 if os.access(path, os.X_OK) else 0o644
            with open(path, "rb") as f:
                t.addfile(ti, f)


class Builder:
    def __init__(self, args, man, root, name, version, vdir, entry):
        self.args, self.man, self.root = args, man, root
        self.name, self.version, self.vdir, self.entry = name, version, vdir, entry
        self.dev = Device()
        self._store = None
        self._store_failed = False
        self.results = []

    def store(self):
        if self._store is None and not self._store_failed:
            try:
                self._store = open_store(self.man, self.args.credentials, prefer_write=True)
            except DAError as e:
                warn(f"engine cache not available ({e}). Build without the cache.")
                self._store_failed = True
        return self._store

    def source_sha(self, comp):
        return file_index(self.entry)[comp["source"]][1]

    def check_requirements(self):
        req = self.entry.get("requires") or {}
        runtimes = {c["runtime"] for c in self.entry.get("components", {}).values()}
        checks = [("jetpack_min", "JetPack", lambda: self.dev.jetpack, True)]
        checks.append(("tensorrt_min", "TensorRT", lambda: self.dev.trt, "tensorrt" in runtimes))
        checks.append(("torch_min", "PyTorch", lambda: self.dev.torch, "pytorch" in runtimes))
        checks.append(("onnxruntime_min", "onnxruntime", lambda: self.dev.onnxruntime,
                       "onnxruntime-cpu" in runtimes))
        for key, label, have, needed in checks:
            if needed and req.get(key) and not version_ge(have(), req[key]):
                raise DAError(f"{self.name}@{self.version} needs {label} >= {req[key]}; this device has {have()}")
        for pkg, want in (req.get("python") or {}).items():
            problem = python_package_problem(pkg, want)
            if problem:
                raise DAError(f"{self.name}@{self.version}: {problem}")

    def upload_if_missing(self, cname, key, artifact, meta_path):
        """Upload a verified local result that the cache does not have yet.

        Only results made on this device (origin trtexec/build) are uploaded;
        this lets a publisher build with --no-upload, compare, then upload.
        """
        if self.args.no_upload or read_json(meta_path).get("origin") not in ("trtexec", "build"):
            return ""
        store = self.store()
        if store is None:
            return ""
        try:
            if store.stat(key) is not None:
                return ""
        except DAError as e:
            warn(f"[{cname}] cannot check the cache: {e}")
            return ""
        return ", " + self.upload(cname, key, artifact, meta_path, read_json(meta_path)["sha256"])

    def upload(self, cname, key, artifact, meta_path, digest):
        store = self.store()
        if store is None or self.args.no_upload:
            return "not uploaded"
        try:
            store.upload(key, artifact, {"sha256": digest})
            store.upload(key + ".json", meta_path, {})
            info(f"[{cname}] uploaded to {store.url(key)}")
            return "uploaded"
        except Denied:
            info(f"[{cname}] upload not permitted with this credential (read-only). "
                 f"The result stays on this device only.")
            return "upload not permitted"
        except Exists:
            info(f"[{cname}] the cache already has a result for this tag. The local result is kept.")
            return "cache already set"
        except Exception as e:  # network errors must not fail the build
            warn(f"[{cname}] upload failed: {e}")
            if self.args.require_upload:
                raise DAError(f"[{cname}] upload failed and --require-upload is set") from e
            return "upload failed"

    def fetch(self, cname, key, dest, meta_dest, check):
        """Get one cached artifact. Return True when it is in place."""
        store = self.store()
        if store is None or self.args.no_cache or self.args.rebuild:
            return False
        try:
            if store.stat(key) is None:
                info(f"[{cname}] cache miss: {store.url(key)}")
                return False
            tmpd = Path(tempfile.mkdtemp(dir=self.root / ".tmp"))
            try:
                art, meta = tmpd / dest.name, tmpd / meta_dest.name
                info(f"[{cname}] cache hit: {store.url(key)}")
                store.download(key, art)
                store.download(key + ".json", meta)
                m = read_json(meta)
                if sha256_file(art) != m.get("sha256"):
                    raise DAError("sha256 does not agree with its record")
                check(art, m)
                os.replace(art, dest)
                os.replace(meta, meta_dest)
            finally:
                shutil.rmtree(tmpd, ignore_errors=True)
            return True
        except DAError as e:
            warn(f"[{cname}] cannot use the cache entry ({e}). Build on this device.")
            return False

    def meta(self, cname, comp, tag, digest, size, origin, extra=None):
        m = {"model": self.name, "version": self.version, "component": cname, "tag": tag,
             "runtime": comp["runtime"], "precision": comp.get("precision"),
             "source": comp["source"], "source_sha256": self.source_sha(comp),
             "sha256": digest, "size": size, "origin": origin, "host": socket.gethostname(),
             "created_at": now_utc(), **self.dev.record()}
        m.update(extra or {})
        return m

    # TensorRT --------------------------------------------------------------
    def build_trt(self, cname, comp):
        tag = self.dev.tag_for(comp)
        edir = self.vdir / "engines" / tag
        engine = edir / comp["engine"]
        meta_path = edir / (comp["engine"] + ".json")
        key = engine_prefix(self.name, self.version, tag) + comp["engine"]
        if engine.is_file() and meta_path.is_file() and not self.args.rebuild:
            if read_json(meta_path).get("sha256") == sha256_file(engine):
                info(f"[{cname}] ok: local engine {engine}")
                return "local" + self.upload_if_missing(cname, key, engine, meta_path)
            warn(f"[{cname}] local engine does not agree with its record. Get it again.")
        edir.mkdir(parents=True, exist_ok=True)

        def check(art, m):
            if m.get("tag") != tag or m.get("source_sha256") != self.source_sha(comp):
                raise DAError("record is for another tag or source")
            check_engine_io(art, comp)

        if self.fetch(cname, key, engine, meta_path, check):
            return "cache"

        trtexec = os.environ.get("TRTEXEC", TRTEXEC_DEFAULT)
        if not os.access(trtexec, os.X_OK):
            raise DAError(f"trtexec not found at {trtexec} (set TRTEXEC)")
        tmp = edir / f".{comp['engine']}.{os.getpid()}.tmp"
        log = edir / (comp["engine"] + ".build.log")
        flags = shlex.split(comp.get("trtexec_flags", ""))
        cmd = [trtexec, f"--onnx={self.vdir / comp['source']}", f"--saveEngine={tmp}", *flags]
        info(f"[{cname}] build: {' '.join(shlex.quote(c) for c in cmd)}")
        t0 = time.time()
        with open(log, "w") as lf:
            rc = subprocess.run(cmd, stdout=lf, stderr=subprocess.STDOUT).returncode
        if rc != 0 or not tmp.is_file():
            tmp.unlink(missing_ok=True)
            tail = "".join(log.read_text(errors="replace").splitlines(True)[-15:])
            raise DAError(f"[{cname}] trtexec failed (exit {rc}). Log: {log}\n{tail}")
        check_engine_io(tmp, comp)
        digest = sha256_file(tmp)
        m = self.meta(cname, comp, tag, digest, tmp.stat().st_size, "trtexec",
                      {"trtexec_flags": comp.get("trtexec_flags", ""), "build_seconds": round(time.time() - t0, 1)})
        os.replace(tmp, engine)
        write_json(meta_path, m)
        info(f"[{cname}] built {engine} in {m['build_seconds']} s")
        return "built, " + self.upload(cname, key, engine, meta_path, digest)

    # PyTorch extensions ----------------------------------------------------
    def build_torch(self, cname, comp):
        b = comp.get("build")
        if not b:
            info(f"[{cname}] ok: PyTorch {self.dev.torch}, nothing to build")
            return "no build"
        tag = self.dev.tag_for(comp)
        edir = self.vdir / "engines" / tag
        bundle = edir / b["cache_file"]
        meta_path = edir / (b["cache_file"] + ".json")
        bdir = self.vdir / b["dir"]

        def present():
            return all(glob.glob(str(bdir / pat)) for pat in b["artifacts"])

        key = engine_prefix(self.name, self.version, tag) + b["cache_file"]
        if bundle.is_file() and meta_path.is_file() and present() and not self.args.rebuild:
            if read_json(meta_path).get("sha256") == sha256_file(bundle):
                info(f"[{cname}] ok: local build {bundle}")
                return "local" + self.upload_if_missing(cname, key, bundle, meta_path)
        edir.mkdir(parents=True, exist_ok=True)

        def check(art, m):
            if m.get("tag") != tag or m.get("source_sha256") != self.source_sha(comp):
                raise DAError("record is for another tag or source")
            extract_tar(art, bdir)
            self.import_check(cname, bdir, b)

        if self.fetch(cname, key, bundle, meta_path, check):
            return "cache"

        log = edir / (b["cache_file"] + ".build.log")
        info(f"[{cname}] build in {bdir}: {b['command']}")
        t0 = time.time()
        with open(log, "w") as lf:
            rc = subprocess.run(shlex.split(b["command"]), cwd=bdir, stdout=lf, stderr=subprocess.STDOUT).returncode
        if rc != 0:
            tail = "".join(log.read_text(errors="replace").splitlines(True)[-15:])
            raise DAError(f"[{cname}] build failed (exit {rc}). Log: {log}\n{tail}")
        members = []
        for pat in b["artifacts"]:
            found = sorted(glob.glob(str(bdir / pat)))
            if not found:
                raise DAError(f"[{cname}] build made no file for '{pat}'. Log: {log}")
            members += [(os.path.relpath(p, bdir), p) for p in found]
        self.import_check(cname, bdir, b)
        tmp = edir / f".{b['cache_file']}.{os.getpid()}.tmp"
        deterministic_targz(tmp, members)
        digest = sha256_file(tmp)
        m = self.meta(cname, comp, tag, digest, tmp.stat().st_size, "build",
                      {"command": b["command"], "artifacts": [a for a, _ in members],
                       "build_seconds": round(time.time() - t0, 1)})
        os.replace(tmp, bundle)
        write_json(meta_path, m)
        info(f"[{cname}] built {len(members)} file(s) in {m['build_seconds']} s")
        return "built, " + self.upload(cname, key, bundle, meta_path, digest)

    def import_check(self, cname, bdir, b):
        """Load each built extension with torch to prove the ABI is correct."""
        code = ("import importlib.util, sys, torch\n"
                "for p in sys.argv[1:]:\n"
                "    s = importlib.util.spec_from_file_location(p.rsplit('/', 1)[-1].split('.')[0], p)\n"
                "    s.loader.exec_module(importlib.util.module_from_spec(s))\n")
        libs = [p for pat in b["artifacts"] for p in glob.glob(str(bdir / pat)) if p.endswith(".so")]
        if not libs:
            return
        r = subprocess.run([sys.executable, "-c", code, *libs], capture_output=True, text=True)
        if r.returncode != 0:
            raise DAError(f"[{cname}] built extension does not load: {r.stderr.strip().splitlines()[-1:]}")

    # onnxruntime -----------------------------------------------------------
    def check_ort(self, cname, comp):
        check_ort(self.vdir / comp["source"], comp)
        info(f"[{cname}] ok: onnxruntime {self.dev.onnxruntime} (CPU), nothing to build")
        return "no build"

    def run(self, only=None):
        self.check_requirements()
        comps = self.entry.get("components", {})
        if only and only not in comps:
            raise DAError(f"{self.name}@{self.version} has no component '{only}' (has: {', '.join(comps)})")
        for cname, comp in comps.items():
            if only and cname != only:
                continue
            fn = {"tensorrt": self.build_trt, "pytorch": self.build_torch,
                  "onnxruntime-cpu": self.check_ort}[comp["runtime"]]
            self.results.append((cname, comp["runtime"], self.dev.tag_for(comp) or "-", fn(cname, comp)))
        info("")
        for r in self.results:
            info(f"  {r[0]:<16} {r[1]:<16} {r[2]:<40} {r[3]}")


def cmd_build(args):
    man = load_manifest(args)
    name, ver = split_ref(args.ref)
    root = store_root(args)
    with locked_root(root):
        version = ver or current_version(root, name)
        if not version:
            raise DAError(f"{name} has no current version. Run: da-models pull {name}")
        vdir = root / name / version
        if not vdir.is_dir():
            raise DAError(f"{name}@{version} is not pulled. Run: da-models pull {name}@{version}")
        problems = check_version_dir(vdir, quick=True)
        if problems:
            raise DAError(f"{vdir}: {problems[0]}. Run: da-models verify {name}@{version}")
        entry = read_json(vdir / "model.json")["entry"]
        try:
            check_same_files(man.entry(name, version), entry, str(vdir))
        except Missing:
            warn(f"{name}@{version} is not in models.yaml (old clone?). Use the local record.")
        info(f"build {name}@{version} for {Device().module}")
        Builder(args, man, root, name, version, vdir, entry).run(args.only)


