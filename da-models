class Device:
    @cached_property
    def module(self):
        if os.environ.get("DA_DEVICE"):
            return os.environ["DA_DEVICE"]
        try:
            compat = Path("/proc/device-tree/compatible").read_bytes().split(b"\0")
        except OSError:
            raise DAError("cannot read /proc/device-tree/compatible; set DA_DEVICE (e.g. orinnx16)") from None
        for c in compat:
            m = re.search(r"(p37\d\d-\d{4})$", c.decode(errors="ignore"))
            if m and m.group(1) in MODULES:
                return MODULES[m.group(1)]
        raise DAError(f"unknown Jetson module {[c.decode(errors='ignore') for c in compat if c]}; set DA_DEVICE")

    @cached_property
    def l4t(self):
        try:
            txt = Path("/etc/nv_tegra_release").read_text()
        except OSError:
            return "unknown"
        m = re.search(r"R(\d+) \(release\), REVISION: (\d+)\.(\d+)", txt)
        return ".".join(m.groups()) if m else "unknown"

    @cached_property
    def jetpack(self):
        if os.environ.get("DA_JETPACK"):
            return os.environ["DA_JETPACK"]
        installed = run_quiet(["dpkg-query", "-W", "-f=${Status} ${Version}", "nvidia-jetpack"])
        if installed.startswith("install ok installed"):
            return short_version(installed.split()[-1])
        if self.l4t in L4T_TO_JETPACK:
            return L4T_TO_JETPACK[self.l4t]
        m = re.search(r"Candidate:\s*(\d[\w.+-]*)", run_quiet(["apt-cache", "policy", "nvidia-jetpack"]))
        if m:
            return short_version(m.group(1))
        raise DAError(f"cannot find the JetPack version for L4T {self.l4t}; set DA_JETPACK")

    @cached_property
    def trt(self):
        with contextlib.suppress(importlib.metadata.PackageNotFoundError):
            return short_version(importlib.metadata.version("tensorrt"))
        with contextlib.suppress(ImportError):
            import tensorrt
            return short_version(tensorrt.__version__)
        v = run_quiet(["dpkg-query", "-W", "-f=${Version}", "libnvinfer10"])
        if v:
            return short_version(v)
        raise DAError("TensorRT is not installed")

    @cached_property
    def torch(self):
        for pkg in ("torch",):
            with contextlib.suppress(importlib.metadata.PackageNotFoundError):
                return short_version(importlib.metadata.version(pkg))
        raise DAError("PyTorch is not installed")

    @cached_property
    def onnxruntime(self):
        for pkg in ("onnxruntime", "onnxruntime-gpu"):
            with contextlib.suppress(importlib.metadata.PackageNotFoundError):
                return short_version(importlib.metadata.version(pkg))
        raise DAError("onnxruntime is not installed: pip3 install onnxruntime")

    @cached_property
    def cuda(self):
        with contextlib.suppress(OSError, ValueError, KeyError):
            return read_json("/usr/local/cuda/version.json")["cuda"]["version"]
        return "unknown"

    def tag_for(self, comp):
        rt, prec = comp["runtime"], comp.get("precision", "fp32")
        if rt == "tensorrt":
            return f"{self.module}-jp{self.jetpack}-trt{self.trt}-{prec}"
        if rt == "pytorch":
            return f"{self.module}-jp{self.jetpack}-torch{self.torch}-{prec}"
        return None

    def record(self):
        out = {"device": self.module, "l4t": self.l4t, "jetpack": self.jetpack, "cuda": self.cuda}
        for key in ("trt", "torch", "onnxruntime"):
            with contextlib.suppress(DAError):
                out["tensorrt" if key == "trt" else key] = getattr(self, key)
        return out


# --------------------------------------------------------------------------
# Tensor I/O checks
# --------------------------------------------------------------------------

def onnx_io(path):
    try:
        import onnx
    except ImportError as e:
        raise DAError("publish needs the onnx package: pip3 install onnx") from e
    m = onnx.load(str(path), load_external_data=False)
    inits = {i.name for i in m.graph.initializer}

    def conv(v):
        t = v.type.tensor_type
        shape = [d.dim_value if d.HasField("dim_value") else (d.dim_param or "?") for d in t.shape.dim]
        return {"name": v.name, "shape": shape, "dtype": ONNX_DTYPES.get(t.elem_type, str(t.elem_type))}

    return [conv(v) for v in m.graph.input if v.name not in inits], [conv(v) for v in m.graph.output]


def wanted_io(comp):
    want = {t["name"]: ("input", t["shape"]) for t in comp.get("inputs", [])}
    want.update({t["name"]: ("output", t["shape"]) for t in comp.get("outputs", [])})
    return want


def engine_io(path):
    try:
        import tensorrt as trt
    except ImportError as e:
        raise DAError("python3-libnvinfer (tensorrt) is not installed") from e
    logger = trt.Logger(trt.Logger.ERROR)
    trt.init_libnvinfer_plugins(logger, "")
    engine = trt.Runtime(logger).deserialize_cuda_engine(Path(path).read_bytes())
    if engine is None:
        raise DAError(f"{path}: TensorRT cannot load this engine here (other device or TensorRT version?)")
    have = {}
    for i in range(engine.num_io_tensors):
        n = engine.get_tensor_name(i)
        mode = "input" if engine.get_tensor_mode(n) == trt.TensorIOMode.INPUT else "output"
        have[n] = (mode, [int(d) for d in engine.get_tensor_shape(n)])
    del engine
    return have


def check_engine_io(path, comp):
    have, want = engine_io(path), wanted_io(comp)
    if set(have) != set(want):
        raise DAError(f"{path}: engine tensors {sorted(have)} do not agree with models.yaml {sorted(want)}")
    for n, (mode, shape) in want.items():
        hmode, hshape = have[n]
        if hmode != mode:
            raise DAError(f"{path}: tensor {n} is an {hmode} in the engine, an {mode} in models.yaml")
        if len(hshape) != len(shape) or any(
                isinstance(w, int) and h != -1 and h != w for h, w in zip(hshape, shape)):
            raise DAError(f"{path}: tensor {n} shape {hshape} does not agree with models.yaml {shape}")


def check_ort(path, comp):
    try:
        import onnxruntime as ort
    except ImportError as e:
        raise DAError("onnxruntime is not installed: pip3 install onnxruntime") from e
    s = ort.InferenceSession(str(path), providers=["CPUExecutionProvider"])
    have = {i.name: "input" for i in s.get_inputs()}
    have.update({o.name: "output" for o in s.get_outputs()})
    want = {n: mode for n, (mode, _) in wanted_io(comp).items()}
    if have != want:
        raise DAError(f"{path}: onnxruntime tensors {have} do not agree with models.yaml {want}")


