MANIFEST_HEADER = """\
# models.yaml - DriverAgent model registry manifest.
#
# `da-models publish` writes this file. By hand, change only `status`
# (production | candidate | archived) and `description`. The files, sizes
# and sha256 of a published version never change: a version is immutable.
# `da-models pull <model>` selects the newest `production` version only.
"""


class _Dumper(yaml.SafeDumper):
    pass


def _represent_list(dumper, data):
    flow = len(data) <= 8 and all(isinstance(x, (int, float, str)) and len(str(x)) < 40 for x in data)
    return dumper.represent_sequence("tag:yaml.org,2002:seq", data, flow_style=flow)


_Dumper.add_representer(list, _represent_list)


def yaml_dump(data):
    return yaml.dump(data, Dumper=_Dumper, sort_keys=False, default_flow_style=False, width=100)


class Manifest:
    def __init__(self, path):
        self.path = Path(path)
        if not self.path.is_file():
            raise DAError(f"manifest not found: {self.path}")
        data = yaml.safe_load(self.path.read_text()) or {}
        if data.get("schema_version") != SCHEMA_VERSION:
            raise DAError(f"{self.path}: schema_version must be {SCHEMA_VERSION}")
        if not data.get("models"):
            data["models"] = {}
        self.data = data

    @property
    def bucket(self):
        return self.data.get("bucket")

    @property
    def models(self):
        return self.data["models"]

    def model(self, name):
        m = self.models.get(name)
        if m is None:
            raise Missing(f"model '{name}' is not in {self.path}")
        return m

    def versions(self, name):
        return self.model(name).get("versions") or {}

    def entry(self, name, version):
        vs = self.versions(name)
        if version not in vs:
            raise Missing(f"{name}@{version} is not in {self.path}")
        return vs[version]

    def select(self, name, version=None):
        """Explicit version, or the newest production version."""
        if version:
            return version, self.entry(name, version)
        vs = self.versions(name)
        prod = [v for v, e in vs.items() if e.get("status") == "production"]
        if not prod:
            listed = ", ".join(f"{v} ({e.get('status')})" for v, e in
                               sorted(vs.items(), key=lambda kv: parse_version(kv[0]))) or "none"
            raise Missing(f"{name} has no production version. Give the version: "
                          f"da-models pull {name}@<version>. Versions: {listed}")
        v = max(prod, key=parse_version)
        return v, vs[v]

    def add(self, name, version, entry, description=None):
        m = self.models.setdefault(name, {})
        if description and not m.get("description"):
            m["description"] = description
        vs = m.setdefault("versions", {}) or {}
        m["versions"] = vs
        if version in vs:
            raise Exists(f"{name}@{version} is already in {self.path}")
        vs[version] = entry
        m["versions"] = dict(sorted(vs.items(), key=lambda kv: parse_version(kv[0])))

    def save(self):
        tmp = self.path.with_name(f".{self.path.name}.tmp")
        tmp.write_text(MANIFEST_HEADER + "\n" + yaml_dump(self.data))
        os.replace(tmp, self.path)


def load_manifest(args):
    path = args.manifest or os.environ.get("DA_MODELS_MANIFEST") or REPO_DIR / "models.yaml"
    return Manifest(path)


def file_index(entry):
    return {f["name"]: (f["size"], f["sha256"]) for f in entry.get("files", [])}


def check_same_files(a, b, what):
    if file_index(a) != file_index(b):
        raise DAError(f"{what}: the file list (names, sizes, sha256) does not agree with models.yaml")


