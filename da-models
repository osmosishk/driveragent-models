class LocalStore:
    """file:// bucket for tests and offline use. Same create-only rule as GCS."""

    def __init__(self, root):
        self.root = Path(root)
        self.identity = f"{getpass.getuser()}@{socket.gethostname()}"

    def url(self, key):
        return f"file://{self.root}/{key}"

    def _meta(self, key):
        return self.root / ".meta" / (key + ".json")

    def stat(self, key):
        p = self.root / key
        if not p.is_file():
            return None
        meta = read_json(self._meta(key)) if self._meta(key).is_file() else {}
        return {"size": p.stat().st_size, "metadata": meta}

    def list(self, prefix):
        if not self.root.is_dir():
            return []
        out = []
        for p in self.root.rglob("*"):
            rel = p.relative_to(self.root)
            if p.is_file() and rel.parts[0] != ".meta" and str(rel).startswith(prefix):
                out.append(str(rel))
        return sorted(out)

    def download(self, key, dest):
        p = self.root / key
        if not p.is_file():
            raise Missing(f"not found: {self.url(key)}")
        try:
            shutil.copyfile(p, dest)
        except PermissionError as e:
            raise Denied(f"permission denied: {self.url(key)}") from e

    def upload(self, key, src, metadata=None):
        dest = self.root / key
        try:
            dest.parent.mkdir(parents=True, exist_ok=True)
            tmp = dest.with_name(f".{dest.name}.{os.getpid()}.tmp")
            shutil.copyfile(src, tmp)
            try:
                os.link(tmp, dest)  # fails when dest exists: create-only
            except FileExistsError:
                raise Exists(f"already exists (immutable): {self.url(key)}") from None
            finally:
                tmp.unlink(missing_ok=True)
            meta = self._meta(key)
            meta.parent.mkdir(parents=True, exist_ok=True)
            meta.write_text(json.dumps(metadata or {}))
        except PermissionError as e:
            raise Denied(f"permission denied: {self.url(key)}") from e


class GCSStore:
    def __init__(self, bucket, credentials):
        try:
            from google.api_core import exceptions as gexc
            from google.cloud import storage
        except ImportError as e:
            raise DAError("google-cloud-storage is not installed: pip3 install google-cloud-storage") from e
        self._gexc = gexc
        if credentials:
            client = storage.Client.from_service_account_json(str(credentials))
            self.identity = read_json(credentials).get("client_email", str(credentials))
        else:
            client = storage.Client()
            self.identity = "application-default-credentials"
        # Do not call bucket.reload(): the read-only role has no storage.buckets.get.
        self.bucket = client.bucket(bucket)
        self.name = bucket

    def url(self, key):
        return f"gs://{self.name}/{key}"

    @contextlib.contextmanager
    def _errors(self, key):
        x = self._gexc
        try:
            yield
        except (x.Forbidden, x.Unauthorized) as e:
            raise Denied(f"permission denied: {self.url(key)}") from e
        except x.NotFound as e:
            raise Missing(f"not found: {self.url(key)}") from e
        except x.PreconditionFailed as e:
            raise Exists(f"already exists (immutable): {self.url(key)}") from e

    def stat(self, key):
        with self._errors(key):
            b = self.bucket.get_blob(key)
        return None if b is None else {"size": b.size, "metadata": dict(b.metadata or {})}

    def list(self, prefix):
        with self._errors(prefix):
            return sorted(b.name for b in self.bucket.list_blobs(prefix=prefix))

    def download(self, key, dest):
        with self._errors(key):
            self.bucket.blob(key).download_to_filename(str(dest), timeout=900)

    def upload(self, key, src, metadata=None):
        blob = self.bucket.blob(key, chunk_size=32 << 20)
        blob.metadata = metadata or {}
        with self._errors(key):
            # if_generation_match=0: create only, never overwrite.
            blob.upload_from_filename(str(src), if_generation_match=0, timeout=900)


def find_credentials(explicit=None, prefer_write=False):
    for c in (explicit, os.environ.get("DA_MODELS_CREDENTIALS")):
        if c:
            p = Path(c).expanduser()
            if not p.is_file():
                raise DAError(f"credential file not found: {p}")
            return p
    names = ("publisher.json", "reader.json") if prefer_write else ("reader.json", "publisher.json")
    for d in CONFIG_DIRS:
        for n in names:
            if (d / n).is_file():
                return d / n
    if os.environ.get("GOOGLE_APPLICATION_CREDENTIALS"):
        return None
    raise DAError("no credential found. Put the key at ~/.config/driveragent-models/reader.json "
                  "(publisher.json on the publisher host), or set DA_MODELS_CREDENTIALS")


def open_store(manifest, credentials=None, prefer_write=False):
    url = os.environ.get("DA_MODELS_BUCKET") or manifest.bucket
    if not url:
        raise DAError("no bucket: set `bucket:` in models.yaml")
    if url.startswith("file://"):
        return LocalStore(url[len("file://"):])
    if not url.startswith("gs://"):
        raise DAError(f"bad bucket url '{url}': use gs://<bucket>")
    return GCSStore(url[len("gs://"):].strip("/"), find_credentials(credentials, prefer_write))


