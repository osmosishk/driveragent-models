def now_utc():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def human(n):
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024


def sha256_file(path, bufsize=8 << 20):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(bufsize), b""):
            h.update(chunk)
    return h.hexdigest()


def read_json(path):
    return json.loads(Path(path).read_text())


def write_json(path, data):
    path = Path(path)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    tmp.write_text(json.dumps(data, indent=2) + "\n")
    os.replace(tmp, path)


def run_quiet(cmd):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return r.stdout.strip() if r.returncode == 0 else ""


def parse_version(v):
    m = VERSION_RE.match(str(v or ""))
    if not m:
        raise DAError(f"bad version '{v}': use MAJOR.MINOR.PATCH, e.g. 1.0.0")
    major, minor, patch, pre = m.groups()
    # A pre-release (1.0.0-rc1) sorts before its release (1.0.0).
    return (int(major), int(minor), int(patch), 0 if pre else 1, pre or "")


def version_ge(have, need):
    """Loose dotted compare: '10.3.0' >= '10.3', '2.8.0+nv' >= '2.8'."""
    def norm(s):
        return [int(x) for x in re.findall(r"\d+", str(s).split("+")[0])]
    a, b = norm(have), norm(need)
    n = max(len(a), len(b))
    return a + [0] * (n - len(a)) >= b + [0] * (n - len(b))


def short_version(v, parts=3):
    m = re.match(r"\d+(?:\.\d+)*", str(v))
    return ".".join(m.group(0).split(".")[:parts]) if m else str(v)


def python_package_problem(pkg, want):
    """None when the installed package satisfies '==X' or '>=X', else a message."""
    try:
        have = importlib.metadata.version(pkg)
    except importlib.metadata.PackageNotFoundError:
        return f"needs Python package {pkg}{want}; it is not installed"
    m = re.match(r"^(==|>=)\s*(\S+)$", str(want))
    if not m:
        raise DAError(f"requires.python.{pkg}: use '==X' or '>=X', not '{want}'")
    op, ver = m.groups()
    ok = short_version(have) == short_version(ver) if op == "==" else version_ge(have, ver)
    return None if ok else f"needs Python package {pkg}{want}; this device has {have}"


def split_ref(ref):
    name, _, ver = ref.partition("@")
    if not NAME_RE.match(name):
        raise DAError(f"bad model name '{name}'")
    if ver:
        parse_version(ver)
    return name, ver or None


