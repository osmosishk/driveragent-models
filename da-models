def store_root(args):
    return Path(args.root or os.environ.get("DA_MODELS_ROOT") or DEFAULT_ROOT)


@contextlib.contextmanager
def locked_root(root):
    if not root.is_dir():
        raise DAError(f"model store {root} does not exist. Make it one time: "
                      f"sudo install -d -o $USER -g $USER {root}")
    if not os.access(root, os.W_OK):
        raise DAError(f"no write permission on {root}")
    (root / ".tmp").mkdir(exist_ok=True)
    with open(root / ".lock", "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            info(f"waiting for another da-models process on {root} ...")
            fcntl.flock(lock, fcntl.LOCK_EX)
        yield root


def current_version(root, name):
    link = root / name / "current"
    return os.readlink(link) if link.is_symlink() else None


def set_current(root, name, version):
    link = root / name / "current"
    tmp = root / name / f".current.{os.getpid()}"
    tmp.unlink(missing_ok=True)
    os.symlink(version, tmp)
    os.replace(tmp, link)  # atomic switch


def local_versions(root, name):
    d = root / name
    if not d.is_dir():
        return []
    out = [p.name for p in d.iterdir() if p.is_dir() and not p.is_symlink() and VERSION_RE.match(p.name)]
    return sorted(out, key=parse_version)


def check_file(path, f):
    size = path.stat().st_size
    if size != f["size"]:
        raise DAError(f"{f['name']}: size {size} is not {f['size']}")
    digest = sha256_file(path)
    if digest != f["sha256"]:
        raise DAError(f"{f['name']}: sha256 {digest} is not {f['sha256']}")


def extract_tar(tar_path, dest):
    with tarfile.open(tar_path, "r:*") as t:
        t.extractall(dest, filter="data")


def check_runtime_tree(vdir, archive):
    """Compare the extracted runtime code with the archive members."""
    problems = []
    with tarfile.open(archive, "r:*") as t:
        for m in t.getmembers():
            if not m.isfile():
                continue
            p = vdir / m.name
            if not p.is_file():
                problems.append(f"runtime file missing: {m.name}")
            elif hashlib.sha256(t.extractfile(m).read()).hexdigest() != sha256_file(p):
                problems.append(f"runtime file changed: {m.name}")
    return problems


def check_version_dir(vdir, quick=False):
    """Return the problems of a pulled version directory (empty list = good)."""
    rec = vdir / "model.json"
    if not rec.is_file():
        return [f"{rec} is missing"]
    entry = read_json(rec)["entry"]
    problems = []
    for f in entry["files"]:
        p = vdir / f["name"]
        if not p.is_file():
            problems.append(f"file missing: {f['name']}")
        elif p.stat().st_size != f["size"]:
            problems.append(f"size mismatch: {f['name']}")
        elif not quick and sha256_file(p) != f["sha256"]:
            problems.append(f"sha256 mismatch: {f['name']}")
    rt = entry.get("runtime")
    if rt and not quick and (vdir / rt["file"]).is_file():
        problems += check_runtime_tree(vdir, vdir / rt["file"])
    return problems


