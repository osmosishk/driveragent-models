def cmd_cache_put(args):
    man = load_manifest(args)
    name, version = split_ref(args.ref)
    if not version:
        raise DAError("give the version: <model>@<version>")
    entry = man.entry(name, version)
    comp = (entry.get("components") or {}).get(args.component)
    if not comp or comp["runtime"] != "tensorrt":
        raise DAError(f"{name}@{version} has no TensorRT component '{args.component}'")
    engine = Path(args.engine)
    check_engine_io(engine, comp)
    dev = Device()
    tag = dev.tag_for(comp)
    store = open_store(man, args.credentials, prefer_write=True)
    key = engine_prefix(name, version, tag) + comp["engine"]
    if store.stat(key) is not None:
        raise Exists(f"{store.url(key)} already exists")
    digest = sha256_file(engine)
    meta = {"model": name, "version": version, "component": args.component, "tag": tag,
            "runtime": "tensorrt", "precision": comp.get("precision"), "source": comp["source"],
            "source_sha256": file_index(entry)[comp["source"]][1], "sha256": digest,
            "size": engine.stat().st_size, "origin": "seeded", "seed_path": str(engine.resolve()),
            "trtexec_flags": comp.get("trtexec_flags", ""), "note": args.note or "",
            "host": socket.gethostname(), "created_at": now_utc(), **dev.record()}
    with tempfile.TemporaryDirectory() as d:
        mp = Path(d) / "meta.json"
        write_json(mp, meta)
        store.upload(key, engine, {"sha256": digest})
        store.upload(key + ".json", mp, {})
    info(f"put {engine} -> {store.url(key)}")


def cmd_device(args):
    dev = Device()
    for k, v in dev.record().items():
        info(f"{k:<12} {v}")
    info(f"{'tag (trt)':<12} {dev.module}-jp{dev.jetpack}-trt{dev.trt}-<precision>")


# --------------------------------------------------------------------------

def main(argv=None):
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--manifest", help="models.yaml (default: next to this tool, or $DA_MODELS_MANIFEST)")
    common.add_argument("--root", help=f"local model store (default: $DA_MODELS_ROOT or {DEFAULT_ROOT})")
    common.add_argument("--credentials", help="service-account key file (default: $DA_MODELS_CREDENTIALS, "
                                              "then ~/.config/driveragent-models/{reader,publisher}.json)")
    p = argparse.ArgumentParser(prog="da-models", description="DriverAgent model registry client")
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("list", parents=[common], help="show models and versions")

    s = sub.add_parser("pull", parents=[common], help="download a version into the local store")
    s.add_argument("ref", help="<model> (newest production) or <model>@<version>")
    s.add_argument("--set-current", action="store_true", help="point `current` to this version")
    s.add_argument("--no-current", action="store_true", help="do not change `current`")

    s = sub.add_parser("build", parents=[common], help="get or build the engines for this device")
    s.add_argument("ref", help="<model> (the current version) or <model>@<version>")
    s.add_argument("--only", metavar="COMPONENT", help="only this component")
    s.add_argument("--no-cache", action="store_true", help="do not download from the engine cache")
    s.add_argument("--no-upload", action="store_true", help="do not upload to the engine cache")
    s.add_argument("--rebuild", action="store_true", help="build again with trtexec, ignore all caches")
    s.add_argument("--require-upload", action="store_true", help="fail when the upload fails (not on denial)")

    s = sub.add_parser("verify", parents=[common], help="check the local store (and the bucket)")
    s.add_argument("ref", nargs="?", help="<model> or <model>@<version> (default: all)")
    s.add_argument("--deep", action="store_true", help="also load each engine/ONNX and check its tensors")
    s.add_argument("--remote", action="store_true", help="also check the bucket against models.yaml")

    s = sub.add_parser("publish", parents=[common], help="upload a new version (publisher only)")
    s.add_argument("spec", help="release spec YAML (see releases/)")
    s.add_argument("--dry-run", action="store_true", help="check and print, do not upload")
    s.add_argument("--allow-unpushed", action="store_true", help="allow a code commit not on a remote")

    s = sub.add_parser("cache-put", parents=[common], help="put an engine built on this device in the cache")
    s.add_argument("ref", help="<model>@<version>")
    s.add_argument("component")
    s.add_argument("engine", help="engine file built on this device")
    s.add_argument("--note", help="free text kept in the engine record")

    sub.add_parser("device", parents=[common], help="show the device identity")

    args = p.parse_args(argv)
    commands = {"list": cmd_list, "pull": cmd_pull, "build": cmd_build, "verify": cmd_verify,
                "publish": cmd_publish, "cache-put": cmd_cache_put, "device": cmd_device}
    try:
        commands[args.cmd](args)
        return 0
    except DAError as e:
        print(f"ERROR: {e}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
