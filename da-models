def cmd_list(args):
    man = load_manifest(args)
    root = store_root(args)
    rows = [("MODEL", "VERSION", "STATUS", "SIZE", "LOCAL")]
    for name in sorted(man.models):
        cur = current_version(root, name) if root.is_dir() else None
        for v, e in sorted(man.versions(name).items(), key=lambda kv: parse_version(kv[0]), reverse=True):
            local = ""
            if (root / name / v).is_dir():
                local = "pulled, current" if v == cur else "pulled"
            size = human(sum(f["size"] for f in e.get("files", [])))
            rows.append((name, v, e.get("status", "?"), size, local))
    if len(rows) == 1:
        info("models.yaml has no models.")
        return
    widths = [max(len(r[i]) for r in rows) for i in range(len(rows[0]))]
    for r in rows:
        info("  ".join(c.ljust(w) for c, w in zip(r, widths)).rstrip())
    info("\n`pull <model>` selects the newest production version. "
         "Give <model>@<version> for a candidate or archived version.")


