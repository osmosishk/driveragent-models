def verify_local(man, root, name, version, deep):
    vdir = root / name / version
    problems = check_version_dir(vdir)
    entry = read_json(vdir / "model.json")["entry"] if (vdir / "model.json").is_file() else {}
    if entry:
        try:
            check_same_files(man.entry(name, version), entry, str(vdir))
        except Missing:
            info(f"  note: {name}@{version} is not in models.yaml")
        except DAError as e:
            problems.append(str(e))
    dev = Device()
    for cname, comp in entry.get("components", {}).items():
        rt = comp["runtime"]
        if rt == "onnxruntime-cpu":
            if deep:
                try:
                    check_ort(vdir / comp["source"], comp)
                except DAError as e:
                    problems.append(str(e))
            continue
        if rt == "pytorch" and not comp.get("build"):
            continue
        tag = dev.tag_for(comp)
        art_name = comp["engine"] if rt == "tensorrt" else comp["build"]["cache_file"]
        art = vdir / "engines" / tag / art_name
        meta = art.with_name(art.name + ".json")
        if not art.is_file():
            info(f"  {cname}: not built for {tag} (run: da-models build {name}@{version})")
            continue
        if not meta.is_file() or read_json(meta).get("sha256") != sha256_file(art):
            problems.append(f"{cname}: {art} does not agree with its record")
        elif deep and rt == "tensorrt":
            try:
                check_engine_io(art, comp)
            except DAError as e:
                problems.append(str(e))
    return problems


def verify_remote(man, store, name, version):
    entry = man.entry(name, version)
    prefix = model_prefix(name, version)
    problems = []
    if store.stat(prefix + "model.json") is None:
        problems.append(f"{store.url(prefix + 'model.json')} is missing (upload not complete)")
    for f in entry["files"]:
        st = store.stat(prefix + f["name"])
        if st is None:
            problems.append(f"missing in bucket: {f['name']}")
        elif st["size"] != f["size"]:
            problems.append(f"size in bucket differs: {f['name']}")
        elif st["metadata"].get("sha256") != f["sha256"]:
            problems.append(f"sha256 metadata in bucket differs: {f['name']}")
    return problems


def cmd_verify(args):
    man = load_manifest(args)
    root = store_root(args)
    failed = checked = 0
    name, ver = split_ref(args.ref) if args.ref else (None, None)
    if name:
        names = [name]
    elif root.is_dir():
        names = sorted(p.name for p in root.iterdir() if p.is_dir() and not p.name.startswith("."))
    else:
        names = []
    for n in names:
        cur = current_version(root, n)
        if cur is not None and not (root / n / cur).is_dir():
            info(f"FAIL  {n}/current -> {cur}: target is missing")
            failed += 1
        for v in ([ver] if ver else local_versions(root, n)):
            if not (root / n / v).is_dir():
                if not args.remote:
                    info(f"FAIL  {n}@{v}: not pulled")
                    failed += 1
                continue
            checked += 1
            problems = verify_local(man, root, n, v, args.deep)
            mark = " (current)" if v == cur else ""
            info(f"{'FAIL' if problems else 'OK  '}  local  {n}@{v}{mark}")
            for p in problems:
                info(f"      - {p}")
            failed += bool(problems)
    if args.remote:
        store = open_store(man, args.credentials)
        for n in ([name] if name else sorted(man.models)):
            for v in ([ver] if ver else man.versions(n)):
                checked += 1
                problems = verify_remote(man, store, n, v)
                info(f"{'FAIL' if problems else 'OK  '}  bucket {n}@{v}")
                for p in problems:
                    info(f"      - {p}")
                failed += bool(problems)
    if not checked:
        info(f"nothing to verify in {root}" + ("" if args.remote else " (use --remote to check the bucket)"))
    if failed:
        raise DAError(f"{failed} check(s) failed")


