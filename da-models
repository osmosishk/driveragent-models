def git(repo, *argv):
    r = subprocess.run(["git", "-C", str(repo), *argv], capture_output=True, text=True)
    if r.returncode != 0:
        raise DAError(f"git {' '.join(argv)} failed in {repo}: {r.stderr.strip()}")
    return r.stdout.strip()


def make_runtime_archive(code, out, allow_unpushed=False):
    """git archive of a clean commit -> runtime.tar.gz with members under runtime/.

    Same commit -> same bytes (fixed mtime, gzip mtime 0), so a retry of a
    failed publish uploads an identical object.
    """
    repo = Path(code["repo"]).expanduser()
    subdir = str(code.get("subdir", "")).strip("/")
    top = git(repo, "rev-parse", "--show-toplevel")
    dirty = git(top, "status", "--porcelain", "--untracked-files=all")
    if dirty:
        raise DAError(f"git working tree is not clean: {top}\n{dirty[:2000]}\n"
                      f"Commit or remove the changes, then publish again.")
    commit = git(top, "rev-parse", "HEAD")
    if not allow_unpushed and not git(top, "branch", "-r", "--contains", commit):
        raise DAError(f"commit {commit[:12]} in {top} is not on a remote branch. Push it first "
                      f"(or use --allow-unpushed).")
    if subdir:
        git(top, "cat-file", "-e", f"{commit}:{subdir}")
    commit_time = int(git(top, "show", "-s", "--format=%ct", commit))
    raw = subprocess.run(["git", "-C", top, "archive", "--format=tar", commit] + (["--", subdir] if subdir else []),
                         capture_output=True, check=True).stdout
    n = 0
    with tarfile.open(fileobj=io.BytesIO(raw)) as src, open(out, "wb") as fo, \
            gzip.GzipFile(filename="", mode="wb", fileobj=fo, mtime=0) as gz, \
            tarfile.open(fileobj=gz, mode="w", format=tarfile.PAX_FORMAT) as dst:
        for m in src.getmembers():
            rel = m.name.rstrip("/")
            if subdir:
                if not rel.startswith(subdir + "/"):
                    continue
                rel = rel[len(subdir) + 1:]
            m2 = tarfile.TarInfo("runtime/" + rel)
            m2.type, m2.mode, m2.size, m2.linkname = m.type, m.mode, m.size, m.linkname
            m2.mtime = commit_time
            dst.addfile(m2, src.extractfile(m) if m.isfile() else None)
            n += m.isfile()
    if not n:
        raise DAError(f"{top}:{subdir or '.'} has no files at {commit[:12]}")
    remote = ""
    with contextlib.suppress(DAError):
        remote = git(top, "remote", "get-url", "origin")
    return {"file": RUNTIME_ARCHIVE, "git_repo": remote or top, "git_commit": commit,
            "git_subdir": subdir or "."}


def build_components(spec, paths):
    comps = {}
    for cname, c in (spec.get("components") or {}).items():
        if not NAME_RE.match(cname):
            raise DAError(f"bad component name '{cname}'")
        c = dict(c)
        rt = c.get("runtime")
        if rt not in RUNTIMES:
            raise DAError(f"component {cname}: runtime must be one of {RUNTIMES}")
        if c.get("source") not in paths:
            raise DAError(f"component {cname}: source '{c.get('source')}' is not in files")
        if not c.get("precision"):
            raise DAError(f"component {cname}: precision is required")
        if rt == "tensorrt":
            if not FILE_RE.match(str(c.get("engine", ""))):
                raise DAError(f"component {cname}: engine (file name) is required")
            flags = c.get("trtexec_flags", "")
            if re.search(r"--(onnx|saveEngine|loadEngine)\b", flags):
                raise DAError(f"component {cname}: trtexec_flags must not set --onnx/--saveEngine/--loadEngine")
        if rt == "pytorch" and c.get("build"):
            b = c["build"]
            for k in ("dir", "command", "artifacts", "cache_file"):
                if not b.get(k):
                    raise DAError(f"component {cname}: build.{k} is required")
        if c["source"].endswith(".onnx") and rt != "pytorch":
            ins, outs = onnx_io(paths[c["source"]])
            for key, got in (("inputs", ins), ("outputs", outs)):
                if c.get(key):
                    if [t["name"] for t in c[key]] != [t["name"] for t in got]:
                        raise DAError(f"component {cname}: {key} names {[t['name'] for t in c[key]]} "
                                      f"do not agree with the ONNX {[t['name'] for t in got]}")
                    for t, g in zip(c[key], got):
                        t.setdefault("dtype", g["dtype"])
                else:
                    c[key] = got
        if not c.get("inputs") or not c.get("outputs"):
            raise DAError(f"component {cname}: inputs and outputs are required")
        comps[cname] = c
    if not comps:
        raise DAError("spec has no components")
    return comps


def cmd_publish(args):
    man = load_manifest(args)
    spec_path = Path(args.spec)
    spec = yaml.safe_load(spec_path.read_text()) or {}
    name, version, status = spec.get("model"), str(spec.get("version", "")), spec.get("status")
    if not NAME_RE.match(str(name)):
        raise DAError(f"bad model name '{name}'")
    parse_version(version)
    if status not in STATUSES:
        raise DAError(f"status must be one of {STATUSES}")
    with contextlib.suppress(Missing):
        if version in man.versions(name):
            raise Exists(f"{name}@{version} is already in models.yaml. A version is immutable: use a new number.")

    store = open_store(man, args.credentials, prefer_write=True)
    prefix = model_prefix(name, version)
    if store.stat(prefix + "model.json") is not None:
        raise Exists(f"{store.url(prefix)} is already published but models.yaml does not list it. "
                     f"Get models.yaml from git; do not publish this version again.")
    dev = Device()
    work = Path(tempfile.mkdtemp(prefix="da-publish-"))
    try:
        paths = {}
        for f in spec.get("files") or []:
            fname, fpath = f.get("name"), Path(str(f.get("path", ""))).expanduser()
            if not fname or not FILE_RE.match(fname) or fname in RESERVED_FILES:
                raise DAError(f"bad file name '{fname}'")
            if fname in paths:
                raise DAError(f"file name '{fname}' is given two times")
            if not fpath.is_file():
                raise DAError(f"{fname}: {fpath} not found")
            paths[fname] = fpath
        runtime = None
        if spec.get("code"):
            runtime = make_runtime_archive(spec["code"], work / RUNTIME_ARCHIVE, args.allow_unpushed)
            paths[RUNTIME_ARCHIVE] = work / RUNTIME_ARCHIVE
        components = build_components(spec, paths)

        files = []
        for fname, fpath in paths.items():
            info(f"  sha256 {fname} ...")
            files.append({"name": fname, "size": fpath.stat().st_size, "sha256": sha256_file(fpath)})
        entry = {"status": status, "published_at": now_utc(), "published_by": store.identity}
        for k in ("upstream", "notes"):
            if spec.get(k):
                entry[k] = spec[k]
        entry["requires"] = spec.get("requires") or {}
        entry["tested_with"] = dev.record()
        for pkg, want in (entry["requires"].get("python") or {}).items():
            python_package_problem(pkg, want)  # validates the syntax
            with contextlib.suppress(importlib.metadata.PackageNotFoundError):
                entry["tested_with"].setdefault("python", {})[pkg] = importlib.metadata.version(pkg)
        if runtime:
            entry["runtime"] = runtime
        entry["files"] = files
        entry["components"] = components
        for k in ("preprocessing", "postprocessing"):
            if spec.get(k):
                entry[k] = spec[k]

        info(f"\n{name}@{version} ({status}): {len(files)} files, "
             f"{human(sum(f['size'] for f in files))} -> {store.url(prefix)}")
        if args.dry_run:
            info("\n--- dry run: models.yaml entry ---\n" + yaml_dump({name: {"versions": {version: entry}}}))
            return

        # A failed earlier attempt can leave some objects. Keep them only when identical.
        existing = {k[len(prefix):]: store.stat(k) for k in store.list(prefix)}
        want = {f["name"]: f for f in files}
        for fname, st in existing.items():
            if fname not in want or st["metadata"].get("sha256") != want[fname]["sha256"]:
                raise Exists(f"{store.url(prefix + fname)} exists with other content. Use a new version.")
        for f in files:
            if f["name"] in existing:
                info(f"  keep  {f['name']} (already uploaded, same sha256)")
                continue
            info(f"  put   {f['name']} ({human(f['size'])})")
            store.upload(prefix + f["name"], paths[f["name"]], {"sha256": f["sha256"]})
        record = work / "model.json"
        write_json(record, {"name": name, "version": version, "entry": entry})
        store.upload(prefix + "model.json", record, {})  # last: marks the version complete
        man.add(name, version, entry, spec.get("description"))
        man.save()
        info(f"\npublished {name}@{version}. Now commit models.yaml:\n"
             f"  git -C {man.path.parent} add models.yaml && "
             f"git -C {man.path.parent} commit -m 'publish {name}@{version}'")
    finally:
        shutil.rmtree(work, ignore_errors=True)


